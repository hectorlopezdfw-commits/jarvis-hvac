APP_NAME=Jarvis HVAC
APP_ENV=development
HOST=0.0.0.0
PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_SERVICE_AREA=local
DEFAULT_TIMEZONE=America/Chicago
BUSINESS_NAME=Your HVAC Company
APP_URL=http://localhost:8000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEFAULT_REVIEW_LINK=https://www.google.com/maps
REVIEW_REQUEST_MESSAGE=Thanks for choosing us! If you have a minute, could you leave us a quick review?
# Optional. Postgres URL (Render provides postgres://...). Leave unset to use SQLite at data/jarvis.db.
DATABASE_URL=
# Shared password for the demo dashboard and lead-reading API. Leave unset to keep that data locked.
DASHBOARD_PASSWORD=
# E.164 number that receives a short SMS when someone signs up on firstringtx.com. Leave unset to skip SMS.
OWNER_ALERT_PHONE=
# Inbox that receives the full sign-up answers. Leave unset to skip email.
OWNER_ALERT_EMAIL=
# Resend API key (https://resend.com). Render free tier cannot send SMTP. Leave unset to skip email.
RESEND_API_KEY=
# From address on a domain verified in Resend, for example alerts@firstringtx.com.
ALERT_FROM_EMAIL=
# Optional HTTP email provider. resend is the default. See app/services/email.py to add another.
EMAIL_PROVIDER=resend
